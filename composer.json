{
    "name": "gizmocraft/zendframework1-filter",
    "description": "Zend Framework 1 Filter component",
    "type": "library",
    "keywords": [
        "framework",
        "zf1"
    ],
    "homepage": "http://framework.zend.com/",
    "license": "BSD-3-Clause",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "gizmocraft/zendframework1-exception": "^2.0.0",
        "gizmocraft/zendframework1-config": "^3.0.0",
        "gizmocraft/zendframework1-loader": "^2.0.0",
        "gizmocraft/zendframework1-crypt": "^2.0.0",
        "gizmocraft/zendframework1-date": "^2.0.0",
        "gizmocraft/zendframework1-locale": "^2.0.0"
    },
    "autoload": {
        "psr-0": {
            "Zend_Filter_": "src/"
        },
        "classmap": [
            "src/Zend/Filter.php"
        ]
    },
    "autoload-dev": {
        "psr-0": {
            "Zend_": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.8",
        "phpstan/phpstan": "^2.3.7",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "pear/archive_tar": "^1.4.6",
        "phpro/grumphp-shim": "^2.27.2"
    },
    "include-path": [
        "src/"
    ],
    "archive": {
        "exclude": [
            "/tests"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test-with-coverage": "phpunit --coverage-clover=clover.xml",
        "phpstan": "phpstan analyze -c phpstan.neon --no-progress --ansi --memory-limit=1024M",
        "style-check": "php-cs-fixer fix --dry-run -vv"
    },
    "suggest": {
        "ext-iconv": "Optionally used in the Zend_Filter_HtmlEntities filter",
        "ext-ctype": "Used in the Zend_Filter_Encrypt_Openssl filter",
        "ext-mbstring": "Optionally used in the Zend_Filter_StringToLower/Upper filters",
        "ext-mcrypt": "Used in the Zend_Filter_Encrypt_Mcrypt filter",
        "ext-zlib": "Used in the Zend_Filter_Compress_Gz filter",
        "ext-openssl": "Used in the Zend_Filter_Encrypt_Openssl filter",
        "ext-bz2": "Used in the Zend_Filter_Compress_Bz2 and (optionally) in the Zend_Filter_Compress_Tar filters",
        "ext-zip": "Used in the Zend_Filter_Compress_Zip filter",
        "ext-rar": "Used in the Zend_Filter_Compress_Rar filter",
        "ext-lzf": "Used in the Zend_Filter_Compress_Lzf filter",
        "pear/archive_tar": "For the Zend_Filter_Compress_Tar filter",
        "gizmocraft/zendframework1-filter-input": "Provides the separate Zend_Filter_Input component"
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp-shim": true
        }
    }
}
